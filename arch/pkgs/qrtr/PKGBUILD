# Qualcomm IPC Router userspace (libqrtr), needed by rmtfs and tqftpserv.
# Not packaged by Arch Linux ARM. Same version as the pmOS install on lisa.
pkgname=qrtr
pkgver=1.2
pkgrel=1
pkgdesc="Qualcomm IPC Router library and tools"
arch=(aarch64)
url="https://github.com/linux-msm/qrtr"
license=(BSD-3-Clause)
depends=(glibc)
makedepends=(meson)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7a82bf80246fe71287b13c66c0466208822e8337fcd4aaf302eee6c5fcb48a52')

build() {
	# The kernel has the in-kernel name service, the userspace qrtr-ns is not wanted.
	arch-meson "$pkgname-$pkgver" build -Dqrtr-ns=disabled
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
