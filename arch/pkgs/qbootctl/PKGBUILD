# Marks the running A/B slot as successfully booted. Without it the ABL counts
# every boot as a failure and eventually switches slot.
# Not packaged by Arch Linux ARM. Same version as the pmOS install on lisa.
pkgname=qbootctl
pkgver=0.2.2
pkgrel=1
pkgdesc="Qualcomm bootctl HAL port for Linux"
arch=(aarch64)
url="https://github.com/linux-msm/qbootctl"
license=(GPL-3.0-only)
depends=(glibc)
makedepends=(meson linux-api-headers)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
	qbootctl.service)
sha256sums=('e66b361f86fac413f6a96974b4045a1fbc385f9eb6cee7fa8a26e0ca77c74a51'
	'b8efed583bc380f4f9b48322517c0855b0f9f8a80ffe1f219ce50bcff6e8cd97')

build() {
	arch-meson "$pkgname-$pkgver" build
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 qbootctl.service "$pkgdir/usr/lib/systemd/system/qbootctl.service"
}
