# TFTP server over QRTR: the modem and the DSPs read their config files through it.
# Not packaged by Arch Linux ARM. Same version as the pmOS install on lisa.
pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc="Trivial File Transfer Protocol server over AF_QIPCRTR"
arch=(aarch64)
url="https://github.com/linux-msm/tqftpserv"
license=(BSD-3-Clause)
depends=(qrtr zstd)
makedepends=(meson systemd)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
	arch-meson "$pkgname-$pkgver" build
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
