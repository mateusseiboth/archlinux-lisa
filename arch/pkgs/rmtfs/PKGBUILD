# Qualcomm remote filesystem service: serves the modem EFS partitions.
# Not packaged by Arch Linux ARM. Same version as the pmOS install on lisa.
pkgname=rmtfs
pkgver=1.3
pkgrel=1
pkgdesc="Qualcomm remotefs service"
arch=(aarch64)
url="https://github.com/linux-msm/rmtfs"
license=(BSD-3-Clause)
depends=(qrtr systemd-libs)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4b6c398806a1046e2256a685d592833de0f37b7245b8adc4797e1791f0e117ee')

prepare() {
	# The generated QMI code is shipped; keep make from asking for qmic.
	touch "$pkgname-$pkgver/qmi_rmtfs.c"
}

build() {
	make -C "$pkgname-$pkgver" prefix=/usr
}

package() {
	make -C "$pkgname-$pkgver" prefix=/usr DESTDIR="$pkgdir" install
	install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
